+import { a as docsPageFromBody, i as docsPageContextKey, n as docsAssistantModel, o as docsRateLimit, r as docsInstructions, t as defineDocsAssistant } from "./assistant-shared-CdtXowot.js";
+import { workspaceShell } from "@vite-hub/agent/capabilities";
+import { chatgpt } from "@vite-hub/gateways";
+//#region src/assistant-worker.ts
+/**
+* The docs assistant in a Worker build: the `docsAssistant` of Node.js with a model-backed Driver on the same ChatGPT
+* plan, because a Worker cannot start Codex. The model reads the pages with the read-only Workspace shell, which
+* Codex does not need: it has its own.
+*/
+const docsAssistant = defineDocsAssistant({
+	model: docsAssistantModel,
+	gateway: chatgpt(),
+	instructions: docsInstructions
+}, [workspaceShell()]);
+//#endregion
+export { docsAssistant, docsPageContextKey, docsPageFromBody, docsRateLimit };
