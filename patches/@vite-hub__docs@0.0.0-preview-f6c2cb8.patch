+import { RateLimitIdentity } from "@vite-hub/agent/capabilities";
+import { AgentCapabilityDefinition, WorkspaceAgentDefinition } from "@vite-hub/agent";
+import { RateLimitWindow } from "@vite-hub/rate-limit";
+//#region src/assistant-shared.d.ts
+/** Invocation context key that holds the path of the page the reader has open. */
+declare const docsPageContextKey = "docsPage";
+/** Returns the page path from a chat request body, or an empty string when it is missing or not a plain path. */
+declare function docsPageFromBody(body: Readonly<Record<string, unknown>>): string;
+interface DocsRateLimitOptions {
+  /** Questions per window. Defaults to 30. */
+  limit?: number;
+  /** Defaults to `1h`. */
+  window?: RateLimitWindow;
+  /**
+   * Who shares one budget. Defaults to the whole site, because anonymous readers have no stable identity. Use `"ip"`
+   * with `trustedIpHeaders` behind a proxy that sets them, or a function of the Invocation context.
+   */
+  identity?: RateLimitIdentity;
+  trustedIpHeaders?: string[];
+}
+/**
+ * The assistant's question limit, with the id `docs-rate-limit` that replaces the default one. Counters live in process
+ * memory: they reset on restart and do not span processes.
+ */
+declare function docsRateLimit(options?: DocsRateLimitOptions): AgentCapabilityDefinition;
+//#endregion
+export { docsRateLimit as i, docsPageContextKey as n, docsPageFromBody as r, DocsRateLimitOptions as t };
