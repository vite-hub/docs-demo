diff --git a/dist/runtime/mcp/list-pages.js b/dist/runtime/mcp/list-pages.js
new file mode 100644
index 0000000000000000000000000000000000000000..0ba05f0d4f0e19c005356950a2bdb259bcc37082
--- /dev/null
+++ b/dist/runtime/mcp/list-pages.js
@@ -0,0 +1,31 @@
+import { listAgentPages } from "#agent-discovery";
+import { useRuntimeConfig } from "#imports";
+import { useEvent } from "nitropack/runtime";
+import { defineMcpTool } from "@nuxtjs/mcp-toolkit/server";
+//#region runtime/mcp/list-pages.ts
+var list_pages_default = defineMcpTool({
+	name: "list-pages",
+	description: `Lists every documentation page with its title, path, description, and URL.
+
+Use it to find pages about a topic when you do not know the exact path. Then read a page with get-page.`,
+	annotations: {
+		readOnlyHint: true,
+		destructiveHint: false,
+		idempotentHint: true,
+		openWorldHint: false
+	},
+	cache: "1h",
+	handler: async () => {
+		const event = useEvent();
+		const { appBase } = useRuntimeConfig(event).public.docs;
+		const prefix = appBase.replace(/\/+$/, "");
+		return (await listAgentPages(event)).map((page) => ({
+			title: page.title,
+			path: page.route.startsWith(`${prefix}/`) ? page.route.slice(prefix.length) || "/" : page.route,
+			description: page.description,
+			url: page.url
+		}));
+	}
+});
+//#endregion
+export { list_pages_default as default };
