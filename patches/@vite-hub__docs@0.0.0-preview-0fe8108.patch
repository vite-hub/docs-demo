diff --git a/dist/runtime/mcp/get-page.js b/dist/runtime/mcp/get-page.js
new file mode 100644
index 0000000000000000000000000000000000000000..bb731e79e483f55505e3fbf5f33b354c997d0ee6
--- /dev/null
+++ b/dist/runtime/mcp/get-page.js
@@ -0,0 +1,39 @@
+import { getAgentDocument } from "#agent-discovery";
+import { createError, useRuntimeConfig } from "#imports";
+import { useEvent } from "nitropack/runtime";
+import { defineMcpTool } from "@nuxtjs/mcp-toolkit/server";
+import { z } from "zod";
+import { docsAppPath } from "#docs/navigation";
+//#region runtime/mcp/get-page.ts
+var get_page_default = defineMcpTool({
+	name: "get-page",
+	description: `Reads one documentation page as Markdown, with its title, description, and URL.
+
+Use a path from list-pages or from a link, such as /docs/getting-started.`,
+	annotations: {
+		readOnlyHint: true,
+		destructiveHint: false,
+		idempotentHint: true,
+		openWorldHint: false
+	},
+	inputSchema: { path: z.string().describe("Page path from list-pages, such as /docs/getting-started") },
+	cache: "1h",
+	handler: async ({ path }) => {
+		const event = useEvent();
+		const { appBase } = useRuntimeConfig(event).public.docs;
+		const document = await getAgentDocument(event, docsAppPath(path, appBase));
+		if (!document || "redirect" in document) throw createError({
+			statusCode: 404,
+			statusMessage: `No page at ${path}`
+		});
+		return {
+			title: document.title,
+			path,
+			description: document.description,
+			content: document.markdown,
+			url: document.canonicalUrl
+		};
+	}
+});
+//#endregion
+export { get_page_default as default };
